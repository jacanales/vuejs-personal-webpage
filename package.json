{
  "name": "package.json",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "run-p type-check:ts7 type-check:vue",
    "type-check:ts7": "node ./node_modules/typescript-native/lib/tsc.js -b tsconfig.ts7.json",
    "type-check:vue": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "typescript": "7.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
